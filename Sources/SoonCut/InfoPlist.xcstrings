{
  "sourceLanguage": "zh-Hant",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "錄影時一起收音的權限說明",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soon-Cut uses the microphone to record your voice-over along with the screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Soon-Cut 需要使用麥克風，才能在螢幕錄影時一起錄下你的旁白。"
          }
        }
      }
    }
  }
}
